# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mirrai_db

# JWT
JWT_SECRET=replace-with-32-plus-chars-random-secret-do-not-commit
JWT_EXPIRATION=8h

# LLM Provider (OpenAI-compatible)
# Default model: deepseek-v4-flash (text-only, no native thinking, no vision)
# Thinking & vision are OFF by default for the system LLM.
# To use a model that supports native thinking or vision, enable BYOK and toggle them on.
OPENAI_API_KEY=your-api-key
# Optional fallback if you use OpenRouter specifically
# OPENROUTER_API_KEY=your-openrouter-key
OPENAI_MODEL=deepseek-v4-flash
# Override base URL for non-OpenAI endpoints
# OPENAI_API_BASE_URL=https://api.deepseek.com/v1
# OPENAI_TEMPERATURE=0.7

# Server
PORT=3000
NODE_ENV=development

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# BYOK (Bring Your Own Key) — encryption key for user-supplied LLM API keys
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production; optional in dev (plaintext is stored unencrypted when absent).
BYOK_ENCRYPTION_KEY=
